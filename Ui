                Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = ListContainer })
                Create("UIStroke", { Thickness = 1, Color = Theme.AccentPurple, Parent = ListContainer })
                Create("UIListLayout", { Padding = UDim.new(0, 4), Parent = ListContainer })
                Create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = ListContainer })

                for _, opt in ipairs(options) do
                    local OptBtn = Create("TextButton", {
                        Parent = ListContainer,
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = Theme.ElementBg,
                        Text = "  " .. tostring(opt),
                        Font = Enum.Font.Gotham,
                        TextSize = 12,
                        TextColor3 = Theme.TextSub,
                        TextXAlignment = Enum.TextXAlignment.Left
                    })
                    Create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = OptBtn })

                    OptBtn.MouseButton1Click:Connect(function()
                        if multi then
                            local idx = table.find(selected, opt)
                            if idx then
                                table.remove(selected, idx)
                                OptBtn.BackgroundColor3 = Theme.ElementBg
                                OptBtn.TextColor3 = Theme.TextSub
                            else
                                table.insert(selected, opt)
                                OptBtn.BackgroundColor3 = Theme.AccentPurple
                                OptBtn.TextColor3 = Theme.TextMain
                            end
                            DropBtn.Text = #selected > 0 and (table.concat(selected, ", ") .. "  v") or "0 Dipilih  v"
                            callback(selected)
                        else
                            selected = opt
                            for _, b in ipairs(ListContainer:GetChildren()) do
                                if b:IsA("TextButton") then
                                    b.BackgroundColor3 = Theme.ElementBg
                                    b.TextColor3 = Theme.TextSub
                                end
                            end
                            OptBtn.BackgroundColor3 = Theme.AccentRed
                            OptBtn.TextColor3 = Theme.TextMain
                            DropBtn.Text = tostring(opt) .. "  v"
                            isExpanded = false
                            ListContainer.Visible = false
                            callback(selected)
                        end
                    end)
                end

                DropBtn.MouseButton1Click:Connect(function()
                    isExpanded = not isExpanded
                    ListContainer.Visible = isExpanded
                end)
            end

            return Elements
        end

        local TabElements = CreateElementContainer(Page)

        -- ==========================================
        -- 7. SECTION ([ikon] [judul] [tombol buka tutup])
        -- ==========================================
        function TabElements:CreateSection(secCfg)
            local isOpenSec = (secCfg.DefaultOpen ~= false)
            local SecWrapper = Create("Frame", {
                Parent = Page,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Color3.fromRGB(22, 20, 29)
            })
            Create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = SecWrapper })
            Create("UIStroke", { Thickness = 1, Color = Theme.AccentPurple, Parent = SecWrapper })
            Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = SecWrapper })
            Create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = SecWrapper })

            local SecHeader = Create("TextButton", {
                Parent = SecWrapper,
                Size = UDim2.new(1, 0, 0, 30),
                BackgroundTransparency = 1,
                Text = "",
                LayoutOrder = 1
            })

            Create("ImageLabel", {
                Parent = SecHeader,
                Position = UDim2.new(0, 4, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 16, 0, 16),
                BackgroundTransparency = 1,
                Image = secCfg.Icon or "rbxassetid://7733911828",
                ImageColor3 = Theme.AccentRed
            })

            Create("TextLabel", {
                Parent = SecHeader,
                Position = UDim2.new(0, 26, 0, 0),
                Size = UDim2.new(1, -60, 1, 0),
                BackgroundTransparency = 1,
                Text = secCfg.Title or "Section",
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = Theme.TextMain,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local ToggleArrow = Create("TextLabel", {
                Parent = SecHeader,
                Position = UDim2.new(1, -8, 0.5, 0),
                AnchorPoint = Vector2.new(1, 0.5),
                Size = UDim2.new(0, 24, 0, 24),
                BackgroundTransparency = 1,
                Text = isOpenSec and "[-]" or "[+]",
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextColor3 = Theme.AccentPurple
            })

            local SecContent = Create("Frame", {
                Parent = SecWrapper,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Visible = isOpenSec,
                LayoutOrder = 2
            })
            Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = SecContent })

            SecHeader.MouseButton1Click:Connect(function()
                isOpenSec = not isOpenSec
                SecContent.Visible = isOpenSec
                ToggleArrow.Text = isOpenSec and "[-]" or "[+]"
            end)

            return CreateElementContainer(SecContent)
        end

        return TabElements
    end

    return Window
end

return Library
