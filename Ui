        Instance.new("UIStroke", BarTrack).Color = Theme.Border

        local BarFill = Instance.new("Frame")
        BarFill.Size = UDim2.new(0, 0, 1, 0)
        BarFill.BackgroundColor3 = Color3.new(1, 1, 1)
        BarFill.Parent = BarTrack
        Instance.new("UICorner", BarFill).CornerRadius = UDim.new(1, 0)

        local BarGrad = Instance.new("UIGradient", BarFill)
        BarGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Red),
            ColorSequenceKeypoint.new(1, Theme.Purple)
        })

        -- Ikon Kucing Melompat-Lompat
        local CatIcon = Instance.new("ImageLabel")
        CatIcon.Size = UDim2.new(0, 34, 0, 34)
        CatIcon.Position = UDim2.new(0, 18, 0, 96)
        CatIcon.BackgroundTransparency = 1
        CatIcon.Image = CatIconId
        CatIcon.ImageColor3 = Theme.Text
        CatIcon.Parent = LoaderFrame

        local PercentLabel = Instance.new("TextLabel")
        PercentLabel.Size = UDim2.new(1, -36, 0, 18)
        PercentLabel.Position = UDim2.new(0, 18, 0, 152)
        PercentLabel.BackgroundTransparency = 1
        PercentLabel.Text = "Memuat UI... 0%"
        PercentLabel.Font = Enum.Font.GothamSemibold
        PercentLabel.TextSize = 12
        PercentLabel.TextColor3 = Theme.SubText
        PercentLabel.Parent = LoaderFrame

        -- Animasi Lompat Kucing + Pengisian Bar Loading Sampai Penuh
        local elapsed = 0
        local hoppingConn
        hoppingConn = RunService.RenderStepped:Connect(function(dt)
            elapsed += dt
            local progress = math.clamp(elapsed / LoadTime, 0, 1)

            -- Update Bar Loading
            BarFill.Size = UDim2.new(progress, 0, 1, 0)
            PercentLabel.Text = string.format("Memuat UI... %d%%", math.floor(progress * 100))

            -- Gerakan Kucing Melompat-Lompat mengikuti ujung bar
            local trackStartX = 18
            local trackWidth = BarTrack.AbsoluteSize.X
            local catX = trackStartX + (trackWidth * progress) - (CatIcon.AbsoluteSize.X / 2)
            local hopHeight = math.abs(math.sin(elapsed * 11)) * 16
            CatIcon.Position = UDim2.new(0, math.clamp(catX, 10, 340 - 44), 0, 96 - hopHeight)
            CatIcon.Rotation = math.sin(elapsed * 11) * 14

            if progress >= 1 then
                hoppingConn:Disconnect()
                task.wait(0.2)
                LoaderFrame:Destroy()
                MainFrame.Visible = true
                ToggleLogo.Visible = true
            end
        end)
    end)

    return WindowObj
