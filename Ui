                SecLayout.SortOrder = Enum.SortOrder.LayoutOrder

                local function ResizeSection()
                    if Open then
                        local contentHeight = SecLayout.AbsoluteContentSize.Y + 8
                        SecFrame.Size = UDim2.new(1, -6, 0, 38 + contentHeight)
                    else
                        SecFrame.Size = UDim2.new(1, -6, 0, 36)
                    end
                end

                SecLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(ResizeSection)
                task.defer(ResizeSection)

                SecHeader.MouseButton1Click:Connect(function()
                    Open = not Open
                    Arrow.Text = Open and "▲" or "▼"
                    ResizeSection()
                end)

                return AttachElements(SecContent)
            end

            return Elements
        end

        return AttachElements(Page)
    end

    --// LOADING SCREEN ([logo] [judul/nama pembuatnya] | [ikon kucing melompat-lompat] | [bar loading])
    task.spawn(function()
        local LoaderFrame = Instance.new("Frame")
        LoaderFrame.Name = "LoaderFrame"
        LoaderFrame.Size = UDim2.new(0, 340, 0, 190)
        LoaderFrame.Position = UDim2.new(0.5, -170, 0.5, -95)
        LoaderFrame.BackgroundColor3 = Theme.Background
        LoaderFrame.ClipsDescendants = true
        LoaderFrame.Parent = ScreenGui
        Instance.new("UICorner", LoaderFrame).CornerRadius = UDim.new(0, 12)

        local LoaderScale = Instance.new("UIScale", LoaderFrame)
        local function UpdateLoaderScale()
            local viewport = workspace.CurrentCamera.ViewportSize
            if viewport.X < 600 or viewport.Y < 400 then
                LoaderScale.Scale = math.clamp(viewport.X / 420, 0.7, 1)
            else
                LoaderScale.Scale = 1
            end
        end
        UpdateLoaderScale()
        workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateLoaderScale)

        local LoaderStroke = Instance.new("UIStroke", LoaderFrame)
        LoaderStroke.Thickness = 2
        LoaderStroke.Color = Color3.new(1, 1, 1)
        local LoaderStrokeGrad = Instance.new("UIGradient", LoaderStroke)
        LoaderStrokeGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Red),
            ColorSequenceKeypoint.new(1, Theme.Purple)
        })

        -- Baris Atas: [Logo] [Judul / Nama Pembuatnya]
        local LoaderLogo = Instance.new("ImageLabel")
        LoaderLogo.Size = UDim2.new(0, 40, 0, 40)
        LoaderLogo.Position = UDim2.new(0, 18, 0, 16)
