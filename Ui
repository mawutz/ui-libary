        LoaderAuthor.Font = Enum.Font.Gotham
        LoaderAuthor.TextSize = 12
        LoaderAuthor.TextColor3 = Theme.SubText
        LoaderAuthor.TextXAlignment = Enum.TextXAlignment.Left
        LoaderAuthor.Parent = LoaderFrame

        -- Area Track & Ikon Kucing Melompat-Lompat di Atas Bar Loading
        local BarTrack = Instance.new("Frame")
        BarTrack.Size = UDim2.new(1, -36, 0, 12)
        BarTrack.Position = UDim2.new(0, 18, 0, 132)
        BarTrack.BackgroundColor3 = Theme.Secondary
        BarTrack.Parent = LoaderFrame
