                local Title = Instance.new("TextLabel")
                Title.Size = UDim2.new(1, -135, 0, 20)
                Title.Position = UDim2.new(0, 12, 0, HasDesc and 6 or 9)
                Title.BackgroundTransparency = 1
                Title.Text = Cfg.Title or "Dropdown"
                Title.Font = Enum.Font.GothamSemibold
                Title.TextSize = 13
                Title.TextColor3 = Theme.Text
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Parent = Frame

                if HasDesc then
                    local Desc = Instance.new("TextLabel")
                    Desc.Size = UDim2.new(1, -135, 0, 16)
                    Desc.Position = UDim2.new(0, 12, 0, 27)
                    Desc.BackgroundTransparency = 1
                    Desc.Text = Cfg.Description
                    Desc.Font = Enum.Font.Gotham
                    Desc.TextSize = 11
                    Desc.TextColor3 = Theme.SubText
                    Desc.TextXAlignment = Enum.TextXAlignment.Left
                    Desc.Parent = Frame
                end

                local DropBtn = Instance.new("TextButton")
                DropBtn.Size = UDim2.new(0, 120, 0, 26)
                DropBtn.Position = UDim2.new(1, -132, 0, HasDesc and 13 or 6)
                DropBtn.BackgroundColor3 = Theme.Element
                DropBtn.Text = Multi and "Pilih (0) v" or (tostring(Selected) .. " v")
                DropBtn.Font = Enum.Font.GothamSemibold
                DropBtn.TextSize = 11
                DropBtn.TextColor3 = Theme.Text
                DropBtn.Parent = Frame
                Instance.new("UICorner", DropBtn).CornerRadius = UDim.new(0, 6)
                Instance.new("UIStroke", DropBtn).Color = Theme.Red

                local OptionHolder = Instance.new("Frame")
                OptionHolder.Size = UDim2.new(1, -24, 0, #Options * 28)
                OptionHolder.Position = UDim2.new(0, 12, 0, HasDesc and 54 or 40)
                OptionHolder.BackgroundTransparency = 1
                OptionHolder.Parent = Frame

                local OptLayout = Instance.new("UIListLayout", OptionHolder)
                OptLayout.Padding = UDim.new(0, 4)

                for _, opt in ipairs(Options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, 0, 0, 24)
                    OptBtn.BackgroundColor3 = Theme.Element
                    OptBtn.Text = "  " .. tostring(opt)
                    OptBtn.Font = Enum.Font.Gotham
                    OptBtn.TextSize = 12
                    OptBtn.TextColor3 = Theme.SubText
                    OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                    OptBtn.Parent = OptionHolder
                    Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 5)

                    OptBtn.MouseButton1Click:Connect(function()
                        if Multi then
                            local idx = table.find(Selected, opt)
                            if idx then
                                table.remove(Selected, idx)
                                OptBtn.TextColor3 = Theme.SubText
                                OptBtn.BackgroundColor3 = Theme.Element
                            else
                                table.insert(Selected, opt)
                                OptBtn.TextColor3 = Theme.Text
                                OptBtn.BackgroundColor3 = Theme.Purple
                            end
                            DropBtn.Text = "Pilih (" .. #Selected .. ") v"
                            if Cfg.Callback then Cfg.Callback(Selected) end
                        else
                            Selected = opt
                            for _, b in ipairs(OptionHolder:GetChildren()) do
                                if b:IsA("TextButton") then
                                    b.TextColor3 = Theme.SubText
                                    b.BackgroundColor3 = Theme.Element
                                end
                            end
                            OptBtn.TextColor3 = Theme.Text
                            OptBtn.BackgroundColor3 = Theme.Red
                            DropBtn.Text = tostring(opt) .. " v"
                            Open = false
                            Tween(Frame, {Size = UDim2.new(1, -6, 0, HasDesc and 52 or 38)}, 0.2)
                            if Cfg.Callback then Cfg.Callback(Selected) end
                        end
                    end)
                end

                DropBtn.MouseButton1Click:Connect(function()
                    Open = not Open
                    local BaseH = HasDesc and 52 or 38
                    local TargetH = Open and (BaseH + (#Options * 28) + 8) or BaseH
                    Tween(Frame, {Size = UDim2.new(1, -6, 0, TargetH)}, 0.2)
                end)
            end

            -- 7. SECTION ([ikon] [judul] | [tombol buat buka tutup])
